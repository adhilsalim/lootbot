{
  "name": "lootbot",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev -w server",
    "start": "npm run start -w server",
    "build": "npm run build -w web",
    "test": "vitest run",
    "typecheck": "tsc -p shared && tsc -p server && tsc -p web"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "overrides": {
    "@types/express": "^4.17.21"
  }
}
